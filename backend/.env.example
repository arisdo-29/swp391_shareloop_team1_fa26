# Mẫu biến môi trường cho profile prod. Giá trị dưới đây là GIẢ.
# Sao chép thành .env (đã nằm trong .gitignore) rồi điền giá trị thật; không commit .env.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
DB_URL=jdbc:postgresql://db-host:5432/shareloop
DB_USERNAME=shareloop
DB_PASSWORD=change-me
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@example.com
BREVO_API_KEY=fake-brevo-api-key
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mail-user@example.com
MAIL_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=https://shareloop.example.com
VNPAY_TMN_CODE=FAKETMN1
VNPAY_HASH_SECRET=fake-vnpay-hash-secret
AI_API_KEY=fake-ai-api-key
STORAGE_TYPE=local
