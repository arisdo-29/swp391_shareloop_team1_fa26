# Mẫu biến môi trường cho profile prod. Giá trị dưới đây là GIẢ.
# Sao chép thành .env (đã nằm trong .gitignore) rồi điền giá trị thật; không commit .env.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
DB_URL=jdbc:postgresql://db-host:5432/shareloop
DB_USERNAME=shareloop
DB_PASSWORD=change-me
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@example.com
BREVO_API_KEY=fake-brevo-api-key
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mail-user@example.com
MAIL_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=https://shareloop.example.com
VNPAY_TMN_CODE=FAKETMN1
VNPAY_HASH_SECRET=fake-vnpay-hash-secret
AI_API_KEY=fake-ai-api-key
# local | s3. Với s3 (Cloudflare R2, MinIO...) điền thêm các dòng S3_ bên dưới
STORAGE_TYPE=local
S3_ENDPOINT=https://fake-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=shareloop-media
S3_ACCESS_KEY=fake-access-key
S3_SECRET_KEY=fake-secret-key

# Payment gateway (sample values only)
PAYMENT_PROVIDER=vnpay
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://example.onrender.com/api/v1/payments/vnpay/return
VNPAY_FE_RESULT_URL=https://example.com/credit

# Cloud Run đặt true
ASYNC_INLINE=false

# tạo bằng openssl rand -hex 32
JOBS_TRIGGER_TOKEN=
