 SELECT i.id, r.id, 'GIVE', 'LOGISTICS_CONFIRMED', 'IN_PERSON', 'Cổng chính Đại học FPT',
-       now() + INTERVAL '2 days', now(), now(), now()
+       now() + INTERVAL '2 days', now(), now(), now(), now()
 FROM items i
