 JOIN users r ON r.email = 'binh.demo@shareloop.local'
 WHERE i.title = 'Demo - Bộ ly thủy tinh (đã chốt lịch)'
   AND NOT EXISTS (SELECT 1 FROM requests q WHERE q.item_id = i.id AND q.receiver_id = r.id);
