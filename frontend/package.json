{
  "name": "shareloop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:api && vitest run",
    "test:api": "node scripts/verify-api.mjs",
    "test:moderation": "vitest run src/pages/admin/ModerationChecklistContent.test.tsx src/pages/admin/RejectReasonsContent.test.tsx",
    "test:otp": "vitest run src/components/OtpInput.test.tsx",
    "test:requests": "vitest run src/pages/user/RequestSelection.test.tsx src/utils/meetingSchedule.test.ts",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.8.2",
    "@vitejs/plugin-react": "^5.0.0",
    "axios": "^1.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.2",
    "recharts": "3.10.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  }
}
