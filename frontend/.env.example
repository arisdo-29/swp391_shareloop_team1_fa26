VITE_APP_NAME=SHARELOOP
# Địa chỉ backend. Máy cá nhân: http://localhost:8080; staging: https://shareloop-api.onrender.com
VITE_API_BASE_URL=https://shareloop-api.onrender.com
# Development only: set true to test POST /api/v1/items without calling Media API.
VITE_POST_SKIP_MEDIA_UPLOAD=false
# Bật nút xác nhận nạp MOCK trên trang Credit (staging/demo). Production để false.
VITE_ENABLE_PAYMENT_MOCK=true
