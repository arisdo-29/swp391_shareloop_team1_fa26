# Thống nhất kết thúc dòng (LF) để không sinh diff rác giữa Windows và macOS/Linux
* text=auto eol=lf

# Script Windows giữ CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# File nhị phân
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.jar binary
